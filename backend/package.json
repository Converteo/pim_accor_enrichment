{
  "name": "pim-accor-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/main.ts",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --dir test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.4.0",
    "@google-cloud/run": "4.2.0",
    "@google-cloud/storage": "8.4.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "google-auth-library": "11.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/testing": "12.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
